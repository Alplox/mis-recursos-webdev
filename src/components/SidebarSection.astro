---
import type { Section } from '../types'
import { countLinks } from '../lib/countLinks'

export interface Props {
  section: Section
  count: number
  level?: number
}

const { section, count, level = 0 } = Astro.props

const visibleChildren = section.children.filter(c => countLinks(c) > 0)
const hasChildren = visibleChildren.length > 0
const isSub = level !== 0
---

<div class="sidebar-section" data-section-id={section.id} data-level={level}>
  <button
    class:list={['sidebar-section-toggle', isSub && 'sidebar-section-toggle-sub']}
    data-section-id={section.id}
    data-toc-level={level}
    style={`padding-left:${20 + level * 12}px`}
  >
    <span class="label">{section.name}</span>
    <span class="count">{count}</span>
    {hasChildren && <span class="arrow" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 4L5 6.5L7.5 4"/></svg></span>}
    {!hasChildren && <span class="arrow arrow-placeholder" aria-hidden="true"></span>}
  </button>

  {hasChildren && (
    <div class="sidebar-children" data-level={level + 1}>
      {visibleChildren.map(child => (
        <Astro.self section={child} count={countLinks(child)} level={level + 1} />
      ))}
    </div>
  )}
</div>