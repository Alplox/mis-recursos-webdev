---
import BookmarkExport from './BookmarkExport.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header class="main-header">
  <button class="hamburger" id="main-hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <svg class="hamburger-icon hamburger-icon-open" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#icon-hamburger"/></svg>
    <svg class="hamburger-icon hamburger-icon-close" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#icon-close"/></svg>
  </button>

  <div class="header-search">
    <div class="search-wrapper">
      <span class="icon">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-search"/></svg>
      </span>
      <input
        type="text"
        class="search-input"
        id="search-input"
        placeholder="Buscar recursos..."
        aria-label="Buscar recursos"
      />
      <button class="search-clear" id="search-clear" aria-label="Limpiar búsqueda">&times;</button>
    </div>
  </div>

  <div class="header-actions">
    <BookmarkExport />
    <ThemeToggle />
  </div>
</header>

