---
import { linkItemHtml } from '../lib/linkItem'

export interface Props {
  title: string
  links: Array<{ name: string; url: string; description?: string }>
  sectionId?: string
  level?: number
  /** Rows rendered server-side at their final size so hydration cannot shift them. */
  ssrCount?: number
}

const { title, links, sectionId, level = 3, ssrCount = 0 } = Astro.props
// Keep the heading hierarchy sequential: h2 (category) → h3 → h4 → h5.
// Level 2 is the category's general list, so it sits at the same depth as h3.
const Tag = level >= 5 ? 'h5' : level === 4 ? 'h4' : 'h3'
const headerClass = level >= 5 ? 'lvl5-header' : level === 4 ? 'sub-subcategory-header' : 'subcategory-header'
const gridId = sectionId || ''
const serverLinks = links.slice(0, ssrCount)
const ssrRowsHtml = serverLinks.map(link => linkItemHtml(link)).join('')
const skeletonCount = Math.min(links.length - serverLinks.length, 3)
---

{sectionId ? <div id={sectionId} class="section-anchor"></div> : null}

<div class={headerClass}>
  <Tag>
    {sectionId && (
      <button type="button" class="anchor-link-btn" data-anchor-id={sectionId} aria-label={`Copiar enlace a ${title}`} title="Copiar enlace a esta sección">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-hash"/></svg>
      </button>
    )}
    <span class="heading-text">{title}</span>
    <span class="count">{links.length}</span>
  </Tag>
</div>

<ul class="link-list" data-section-id={gridId}>
  {ssrRowsHtml && <Fragment set:html={ssrRowsHtml} />}
  {Array.from({ length: skeletonCount }).map(() => (
    <li class="link-skeleton" aria-hidden="true">
      <span class="skeleton-line"></span>
    </li>
  ))}
</ul>
