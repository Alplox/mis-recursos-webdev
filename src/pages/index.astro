---
import BaseLayout from '../layouts/BaseLayout.astro'
import Sidebar from '../components/Sidebar.astro'
import SearchBar from '../components/SearchBar.astro'
import LinkGrid from '../components/LinkGrid.astro'
import BottomNav from '../components/BottomNav.astro'

import type { Section } from '../types'
import { countLinks } from '../lib/countLinks'
import recursos from '../data/recursos.json'

const sections = recursos as Section[]
const renderableSections = sections
  .map(section => ({ section, total: countLinks(section) }))
  .filter(({ total }) => total > 0)
---

<BaseLayout>
  <div class="app-layout">
    <Sidebar sections={sections} />

    <div class="main-content">
      <SearchBar />

      <main class="main-body" id="main-content">
        <nav id="breadcrumb" class="breadcrumb" aria-label="Ruta" style="display:none"></nav>
        <div id="search-results" style="display:none">
          <div class="search-results-header" id="search-header"></div>
          <div id="search-results-content"></div>
        </div>

        <div id="browse-content">
          {renderableSections.map(({ section, total: sectionTotal }, i) => {
            const prev = renderableSections[i - 1]?.section
            const next = renderableSections[i + 1]?.section

            if (i !== 0) {
              return (
                <section class="categories-section" data-section={section.id} data-lazy="1" style={`contain-intrinsic-size: auto ${sectionTotal * 25 + 80}px`}></section>
              )
            }

            return (
              <section class="categories-section active" data-section={section.id} data-built="1" style={`contain-intrinsic-size: auto ${sectionTotal * 25 + 80}px`}>
                <div class="category-header" id={section.id}>
                  <h2>
                    <button type="button" class="anchor-link-btn" data-anchor-id={section.id} aria-label={`Copiar enlace a ${section.name}`} title="Copiar enlace a esta sección">
                      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-hash"/></svg>
                    </button>
                    <span class="heading-text">{section.name}</span>
                  </h2>
                  <span class="count-badge">{sectionTotal}</span>
                </div>

                {(prev || next) && (
                  <nav class="category-pagination category-pagination-top" aria-label="Categorías anterior y siguiente">
                    {prev ? (
                      <button type="button" class="category-nav-btn prev" data-goto={prev.id}>
                        <span class="dir">← Anterior</span>
                        <span class="name">{prev.name}</span>
                      </button>
                    ) : <span />}
                    {next ? (
                      <button type="button" class="category-nav-btn next" data-goto={next.id}>
                        <span class="dir">Siguiente →</span>
                        <span class="name">{next.name}</span>
                      </button>
                    ) : <span />}
                  </nav>
                )}

                {section.links.length > 0 && (
                  <LinkGrid title={section.name + ' (general)'} links={section.links} sectionId={section.id + '-links'} level={2} />
                )}

                {section.children.filter(c => c.links.length > 0 || c.children.length > 0).map(child => (
                  <>
                    <LinkGrid title={child.name} links={child.links} sectionId={child.id} level={3} />

                    {child.children.filter(gc => gc.links.length > 0 || gc.children.length > 0).map(gc => (
                      <>
                        <LinkGrid title={gc.name} links={gc.links} sectionId={gc.id} level={4} />

                        {gc.children.filter(ggc => ggc.links.length > 0).map(ggc => (
                          <LinkGrid title={ggc.name} links={ggc.links} sectionId={ggc.id} level={5} />
                        ))}
                      </>
                    ))}
                  </>
                ))}

                {(prev || next) && (
                  <nav class="category-pagination category-pagination-bottom" aria-label="Categorías anterior y siguiente">
                    {prev ? (
                      <button type="button" class="category-nav-btn prev" data-goto={prev.id}>
                        <span class="dir">← Anterior</span>
                        <span class="name">{prev.name}</span>
                      </button>
                    ) : <span />}
                    {next ? (
                      <button type="button" class="category-nav-btn next" data-goto={next.id}>
                        <span class="dir">Siguiente →</span>
                        <span class="name">{next.name}</span>
                      </button>
                    ) : <span />}
                  </nav>
                )}
              </section>
            )
          })}
        </div>

        <div id="empty-state" class="empty-state" style="display:none">
          <div class="empty-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <p>No se encontraron resultados para <strong id="empty-query"></strong></p>
        </div>

      </main>
    </div>
  </div>
  <BottomNav />

  <script>
    ;(function() {
      const STORAGE_KEY = 'recursos-theme'
      function getStored() { try { return localStorage.getItem(STORAGE_KEY) } catch { return null } }
      function getPreferred() {
        const s = getStored()
        if (s === 'light' || s === 'dark') return s
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
      }
      function setTheme(t: string) {
        document.documentElement.setAttribute('data-theme', t)
        try { localStorage.setItem(STORAGE_KEY, t) } catch {}
      }
      setTheme(getPreferred())
      window.__toggleTheme = () => {
        const cur = document.documentElement.getAttribute('data-theme') || 'dark'
        const next = cur === 'dark' ? 'light' : 'dark'
        setTheme(next)
        return next
      }
    })()
  </script>

  <script src="../scripts/client.ts"></script>
</BaseLayout>
